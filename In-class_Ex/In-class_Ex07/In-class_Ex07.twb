      <column caption='Upper Control Limit' datatype='real' name='[Calculation_1408486445330432]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_AVG(SUM([Sales]))+&#13;&#10;WINDOW_STDEV(sum([Sales]))*[Parameters].[Parameter 1]'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Out of Control Limit' datatype='real' name='[Calculation_1408486449451010]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([Sales]) &gt; [Calculation_1408486445330432]&#13;&#10;OR SUM([Sales]) &lt; [Upper Control Limit (copy)_1408486446407681]&#13;&#10;THEN SUM([Sales])&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Selected Year' datatype='boolean' name='[Calculation_1408486454272004]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='INT(YEAR([Order Date])) = [Parameters].[Parameter 2]' />
      </column>
      <column caption='Year Filter' datatype='boolean' name='[Calculation_1408486459408389]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='INT(YEAR([Order Date])) = [Parameters].[Parameter 2]' />
      </column>
      <column caption='Gain or Lost' datatype='string' name='[Calculation_1408486464622598]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF {FIXED [Sub-Category]:SUM(IF DATEPART(&apos;year&apos;,[Order Date]) = 2025 THEN&#13;&#10;[Sales] END)} &gt;&#13;&#10;    {FIXED [Sub-Category]:SUM(IF DATEPART(&apos;year&apos;,[Order Date]) = 2022 then [Sales]END)}&#13;&#10;THEN &quot;Gain&quot; ELSE &quot;Loss&quot; END' />
      </column>
